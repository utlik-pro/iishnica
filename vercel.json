{
  "rewrites": [
    {
      "source": "/api/blog/:slug",
      "destination": "/api/blog/[slug]"
    },
    {
      "source": "/v3",
      "destination": "/v3.html"
    },
    {
      "source": "/(.*)",
      "destination": "/"
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "s-maxage=3600, stale-while-revalidate"
        }
      ]
    }
  ]
}
